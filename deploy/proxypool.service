[Unit]
Description=ProxyPool - free proxy pool with validation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 安装时由 manage.sh 替换这三个占位符
User=__USER__
Group=__GROUP__
WorkingDirectory=__APP_DIR__
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONNOUSERSITE=1
# 清掉外部注入的 PYTHONPATH，否则会加载到错误 venv 的包
Environment=PYTHONPATH=
ExecStart=__APP_DIR__/.venv/bin/python -m proxypool serve
Restart=always
RestartSec=10

# 并发 400 时每个探测占 2-3 个 fd，默认 4096 会 EMFILE。
# 程序启动时也会自动提升，但 systemd 下显式配置更可靠。
LimitNOFILE=65535

# 调度器停服时要取消在跑的探测任务，给够时间
KillSignal=SIGTERM
TimeoutStopSec=30

# 日志进 journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=proxypool

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__APP_DIR__/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
